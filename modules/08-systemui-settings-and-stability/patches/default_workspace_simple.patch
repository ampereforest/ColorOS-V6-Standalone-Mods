# Patch: Clean 4-icon default dock (Phone, Messages, Titanium Browser, MiuiCamera) in system/my_product/etc/launcher/default_workspace_simple.xml
--- a/my_product/etc/launcher/default_workspace_simple.xml
+++ b/my_product/etc/launcher/default_workspace_simple.xml
@@ -494,6 +494,25 @@
         launcher:x="2"
         launcher:y="0">
         <favorite
+            launcher:className="com.google.android.apps.chrome.Main"
+            launcher:packageName="io.github.jqssun.helium" />
+        <favorite
+            launcher:className="com.android.browser.BrowserActivity"
+            launcher:packageName="com.heytap.browser" />
+        <favorite
+            launcher:className="com.android.browser.BrowserActivity"
+            launcher:packageName="com.coloros.browser" />
+    </resolve>
+
+    <resolve
+        launcher:container="-101"
+        launcher:screen="3"
+        launcher:x="3"
+        launcher:y="0">
+        <favorite
+            launcher:className="com.android.camera.Camera"
+            launcher:packageName="com.android.camera" />
+        <favorite
             launcher:className="com.oplus.camera.Camera"
             launcher:packageName="com.oplus.camera" />
         <favorite
@@ -502,5 +521,8 @@
         <favorite
             launcher:className="com.oneplus.camera.CameraActivity"
             launcher:packageName="com.oneplus.camera" />
+        <favorite
+            launcher:className="com.oneplus.camera.OPCameraActivity"
+            launcher:packageName="com.oneplus.camera" />
     </resolve>
 </favorites>
